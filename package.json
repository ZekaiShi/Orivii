{
  "name": "dsh-orivii",
  "version": "1.0.1",
  "description": "Orivii: an expressive personal assistant for DeepSeek Harness with shared memory, proactive reminders and background work",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./dsh/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src",
    "dsh",
    "cordis.patch.yml",
    "README.md",
    "ROADMAP.md",
    "SECURITY.md",
    "LICENSE",
    "CHANGELOG.md",
    "UPDATES.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.mjs",
    "prepack": "npm run build && npm run check && npm test && node scripts/export-public.mjs --check",
    "release:source": "node scripts/export-public.mjs"
  },
  "engines": {
    "node": ">=24.2.0",
    "dsh": "^0.2.1-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "dependencies": {
    "saxes": "6.0.0",
    "turndown": "7.2.4",
    "zod": "4.4.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-modules": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.2",
    "@deepseek-ai/dsh-host-directory-picker-auto": "0.2.1-rc.2",
    "@deepseek-ai/dsh-host-directory-picker-native": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.2",
    "jsdom": "26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-test-renderer": "18.3.1"
  },
  "homepage": "https://github.com/ZekaiShi/Orivii#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZekaiShi/Orivii.git"
  },
  "bugs": {
    "url": "https://github.com/ZekaiShi/Orivii/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "orivii",
    "personal-assistant",
    "memory",
    "agent"
  ]
}
